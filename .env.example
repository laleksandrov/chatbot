NODE_ENV=development
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=false
LOG_LEVEL=info

# The only credentials allowed to sign in at /admin. Store real values only in Forge.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# API clients are managed in PostgreSQL at /admin. Keep this empty after migration.
# During the first deployment only, the old JSON can remain here and be imported with
# npm run api-clients:import-env. It is also a temporary authentication fallback.
API_CLIENTS_JSON=[]

OPENAI_API_KEY=
AI_PROVIDER=fake
OPENAI_MODEL=gpt-5.6-terra
OPENAI_VECTOR_STORE_ID=
OPENAI_REASONING_EFFORT=low
OPENAI_FILE_SEARCH_MAX_RESULTS=10
OPENAI_VECTOR_POLL_INTERVAL_MS=2000
OPENAI_VECTOR_POLL_TIMEOUT_MS=300000

INGESTION_WORKER_POLL_MS=1000
INGESTION_LEASE_SECONDS=300
INGESTION_MAX_ATTEMPTS=5
INGESTION_RETRY_BASE_MS=5000
INGESTION_RETRY_MAX_MS=300000

# Production persistence. Both values are required together.
DATABASE_URL=
# Optional privileged connection used only by db:migrate.
MIGRATION_DATABASE_URL=
CONVERSATION_ENCRYPTION_KEY=
CONVERSATION_RETENTION_DAYS=180

DATA_DIR=./data
MAX_DOCUMENT_BYTES=26214400
