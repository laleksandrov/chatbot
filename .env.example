NODE_ENV=development
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=false
LOG_LEVEL=info

# JSON array. Keep real keys only in the protected server environment.
API_CLIENTS_JSON=[{"tenantId":"ems","key":"replace-me","roles":["chat","documents:read","documents:write","documents:global"]}]

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_VECTOR_STORE_ID=

# Production persistence. Both values are required together.
DATABASE_URL=
CONVERSATION_ENCRYPTION_KEY=
CONVERSATION_RETENTION_DAYS=180

DATA_DIR=./data
MAX_DOCUMENT_BYTES=26214400
